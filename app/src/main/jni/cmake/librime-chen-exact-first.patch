+
+TEST_F(RimeSyllabifierTest, CorrectionNeverReplacesValidSyllables) {
+  rime::NearSearchCorrector corrector;
+  Syllabifier s;
+  s.EnableCorrection(&corrector);
+  for (const auto& input : {"gan", "changan", "tu"}) {
+    SyllableGraph g;
+    EXPECT_EQ(std::string(input).size(), s.BuildSyllableGraph(input, *prism_, &g));
+    for (const auto& start : g.edges)
+      for (const auto& end : start.second)
+        for (const auto& syllable : end.second)
+          EXPECT_FALSE(syllable.second.is_correction);
+  }
+}
+
+TEST_F(RimeSyllabifierTest, CorrectionStillHandlesInvalidSyllable) {
+  rime::NearSearchCorrector corrector;
+  Syllabifier s;
+  s.EnableCorrection(&corrector);
+  SyllableGraph g;
+  EXPECT_EQ(3, s.BuildSyllableGraph("gab", *prism_, &g));
+  EXPECT_TRUE(g.edges[0][3][syllable_id_["gan"]].is_correction);
+}
+
+TEST_F(RimeSyllabifierTest, CorrectionProtectsPrefixesAndShortInput) {
+  NearSearchCorrector corrector;
+  Syllabifier normal(" '");
+  Syllabifier corrected(" '");
+  corrected.EnableCorrection(&corrector);
+  for (const auto& input : {"g", "ch", "tua", "chang", "gan'", "gb"}) {
+    SyllableGraph expected;
+    SyllableGraph actual;
+    EXPECT_EQ(normal.BuildSyllableGraph(input, *prism_, &expected),
+              corrected.BuildSyllableGraph(input, *prism_, &actual));
+    for (const auto& start : actual.edges)
+      for (const auto& end : start.second)
+        for (const auto& syllable : end.second)
+          EXPECT_FALSE(syllable.second.is_correction);
+  }
+}
+
+TEST_F(RimeSyllabifierTest, CorrectionDoesNotReplaceTwoNeighbourKeys) {
+  NearSearchCorrector corrector;
+  Syllabifier s;
+  s.EnableCorrection(&corrector);
+  SyllableGraph g;
+  s.BuildSyllableGraph("gsb", *prism_, &g);
+  for (const auto& start : g.edges)
+    for (const auto& end : start.second)
+      EXPECT_EQ(end.second.end(), end.second.find(syllable_id_["gan"]));
+}
