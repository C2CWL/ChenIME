<resources>
    <style name="TextAppearance.SettingsTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.SettingsEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/settings_input_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/settings_text</item>
        <item name="android:textColorHint">@color/settings_text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.SettingsPlatformEditText" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/settings_input_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/settings_text</item>
        <item name="android:textColorHint">@color/settings_text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="ThemeOverlay.SettingsDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="editTextStyle">@style/Widget.SettingsEditText</item>
        <item name="android:editTextStyle">@style/Widget.SettingsPlatformEditText</item>
        <item name="android:windowBackground">@drawable/settings_dialog_background</item>
        <item name="android:colorBackground">@color/settings_surface</item>
        <item name="android:textColorPrimary">@color/settings_text</item>
        <item name="android:textColorSecondary">@color/settings_text_secondary</item>
        <item name="textColorAlertDialogListItem">@color/settings_text</item>
        <item name="android:textColorAlertDialogListItem">@color/settings_text</item>
        <item name="colorAccent">@color/settings_accent</item>
        <item name="android:colorAccent">@color/settings_accent</item>
    </style>
    <style name="ThemeOverlay.SettingsPlatformDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:editTextStyle">@style/Widget.SettingsPlatformEditText</item>
        <item name="android:windowBackground">@drawable/settings_dialog_background</item>
        <item name="android:colorBackground">@color/settings_surface</item>
        <item name="android:textColorPrimary">@color/settings_text</item>
        <item name="android:textColorSecondary">@color/settings_text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/settings_text</item>
        <item name="android:colorAccent">@color/settings_accent</item>
    </style>
    <style name="Widget.SettingsPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/settings_dialog_background</item>
    </style>
    <style name="Widget.SettingsPlatformPopupMenu" parent="android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/settings_dialog_background</item>
    </style>
</resources>
